        "rig.media.code": {
          "text": "-- fantasy console demo\n-- _init/_update/_draw = SUDE Setup/Update/Draw\n-- Rig document for RigPlayer (.rig)\n\nfunction _init()\n x=64\n y=64\nend\n\nfunction _update()\n if btn(0) then x-=1 end\n if btn(1) then x+=1 end\n if btn(2) then y-=1 end\n if btn(3) then y+=1 end\nend\n\nfunction _draw()\n cls(1)\n map(0,0,0,0,16,2)\n spr(1,x-4,y-4)\n print(\"rig play\",40,4,6)\nend\n",
          "language": "lua",
          "readOnly": false
        }
      }
